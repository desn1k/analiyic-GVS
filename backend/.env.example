# Copy to .env on the server and adjust as needed.

# SQLite by default; point this at a persistent path outside the app dir
# so it survives redeploys, e.g.:
DATABASE_URL=sqlite:////opt/gvs/data/gvs.db

# Comma-separated list of origins allowed to call the API.
# Leave unset if the frontend is served by the same nginx host as /api
# (the default deploy/nginx-gvs.conf setup) — same-origin requests don't need CORS.
# CORS_ORIGINS=https://gvs.example.com
