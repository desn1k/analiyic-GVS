[Unit]
Description=GVS Analytics backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=gvs
Group=gvs
WorkingDirectory=/opt/gvs/backend
EnvironmentFile=/opt/gvs/backend/.env
ExecStart=/opt/gvs/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
